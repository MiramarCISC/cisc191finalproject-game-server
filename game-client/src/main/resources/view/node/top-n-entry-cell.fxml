<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.sdccd.cisc191.client.ui.node.controlller.TopNEntryCellController"
      spacing="5" fx:id="cellContainer">

    <padding>
        <Insets top="5" bottom="5" left="5" right="5"/>
    </padding>

    <stylesheets>
        <URL value="@/css/style.css"/>
    </stylesheets>

    <HBox spacing="5">
        <VBox>
            <HBox>
                <Label styleClass="inline-title" text="Player: "/>
                <Label text="placeholder1234" fx:id="playerNameLabel"/>
            </HBox>

            <HBox>
                <Label styleClass="inline-title" text="Rating: "/>
                <Label fx:id="ratingLabel" text="1234"/>
            </HBox>
        </VBox>
    </HBox>

</VBox>
